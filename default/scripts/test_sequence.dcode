# RUN TEST controls rocket_test_running. Driver and valve tasks run independently.
task_timeline rocket_test 20:
    clock:
        start: T+0s

    at T+0s (fill_ignite_fire):
        execute:
            claim |rocket_sim_fill_request|
            claim |rocket_sim_fuel_request|
            claim |rocket_sim_oxidizer_request|
            claim |rocket_sim_igniter_command|
            set |rocket_sim_phase| = 1
            log("Rocket sequence", "Fill: transferring supply into the run tank to 60 percent")
            while |rocket_sim_run_fill| < 60 or |rocket_sim_sensor_valid| != 1:
                if |rocket_sim_abort_active| == 0:
                    command |rocket_sim_fill_request| = 1
                    command |rocket_sim_fuel_request| = 0
                    command |rocket_sim_oxidizer_request| = 0
                    command |rocket_sim_igniter_command| = 0
                wait_for 100ms

            set |rocket_sim_phase| = 2
            log("Rocket sequence", "Ignition: close fill valve, apply igniter, wait two seconds")
            ignition_seconds = 0
            while ignition_seconds < 2:
                if |rocket_sim_abort_active| == 0:
                    command |rocket_sim_fill_request| = 0
                    command |rocket_sim_igniter_command| = 1
                    ignition_seconds = ignition_seconds + 0.1
                wait_for 100ms

            set |rocket_sim_phase| = 3
            log("Rocket sequence", "Firing: open engine feed valves; abort overrides take precedence")
            while true:
                if |rocket_sim_abort_active| == 0:
                    command |rocket_sim_fill_request| = 0
                    command |rocket_sim_fuel_request| = (|rocket_sim_run_fill| > 1) and 1 or 0
                    command |rocket_sim_oxidizer_request| = (|rocket_sim_run_fill| > 1) and 1 or 0
                    command |rocket_sim_igniter_command| = (|rocket_sim_run_fill| > 1) and 1 or 0
                wait_for 100ms

    stop:
        set |rocket_sim_phase| = 0
        if |rocket_sim_abort_active| == 0:
            command |rocket_sim_fill_request| = 0
            command |rocket_sim_fuel_request| = 0
            command |rocket_sim_oxidizer_request| = 0
            command |rocket_sim_igniter_command| = 0
        free |rocket_sim_fill_request|
        free |rocket_sim_fuel_request|
        free |rocket_sim_oxidizer_request|
        free |rocket_sim_igniter_command|
        log("Rocket sequence", "Idle: timeline stopped, outputs requested off, ownership released")
