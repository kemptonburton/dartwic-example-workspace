event rocket_engine_abort:
    title: "Mock rocket automatic abort"
    type: abort
    description: "Voted temperature exceeds 1500 K, or the simulated sensor input is invalid."
    resolution: "Stop the test, clear the injected fault, and verify the outputs before starting a new run."
    system: "MOCK ROCKET"
    subsystem: "AUTOMATION"
    firing_timeout_seconds: 0
    channels: |rocket_sim_temperature_voted|, >1500; |rocket_sim_sensor_valid|
    trigger:
        if |rocket_sim_temperature_voted| > 1500 or |rocket_sim_sensor_valid| != 1:
            return 1
    on_firing:
        if value:
            |rocket_sim_abort_active| = 1
            override |rocket_sim_fuel_request| = 0
            override |rocket_sim_oxidizer_request| = 0
            override |rocket_sim_fill_request| = 0
            override |rocket_sim_igniter_command| = 0
            log("Rocket sequence", "Abort asserted: closing feed valves and disabling igniter")
        else:
            free |rocket_sim_fuel_request|
            free |rocket_sim_oxidizer_request|
            free |rocket_sim_fill_request|
            free |rocket_sim_igniter_command|
            |rocket_sim_abort_active| = 0
            log("Rocket sequence", "Abort cleared: released overrides; verify state before restarting")
