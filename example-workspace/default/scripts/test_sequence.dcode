# The periodic ox-tank task supplies tank values. This state machine controls
# the fill and vent requests; the device read task supplies applied positions.
# Refresh the phase labels whenever this file is activated.
|rocket_sim_phase|:value_options = [
    {value: 0, label: "idle"},
    {value: 1, label: "tank fill"},
    {value: 2, label: "ignition"},
    {value: 3, label: "firing"}
]

task_state_machine engine_tank_fill:
    start:
        |engine_tank_fill_complete| = 0

    states:
        isolate
        fill
        vent
        manual

    state isolate:
        if |rocket_sim_abort_active| == 0:
            command |rocket_sim_fill_request| = 0
            command |rocket_sim_vent_request| = 0
        if target_state == states.fill:
            |engine_tank_fill_complete| = 0
            fill_target = promptNumerical(
                "Ox tank fill target",
                "Enter the target fill percentage for this engine test.",
                ["rocket_sim_run_fill_target"],
                "Enter a percentage from 1 to 100.",
                0
            )
            if fill_target <= 0 or fill_target > 100:
                error("Ox tank fill target must be between 1 and 100 percent.")
            |rocket_sim_run_fill_target| = fill_target
            transition fill
        if target_state == states.manual:
            transition manual

    state fill:
        if |rocket_sim_abort_active| != 0 or |rocket_sim_sensor_valid| != 1 or target_state == states.isolate:
            transition isolate
        elif target_state == states.manual:
            transition manual
        elif |rocket_sim_run_fill| >= |rocket_sim_run_fill_target|:
            |engine_tank_fill_complete| = 1
            transition isolate
        elif |rocket_sim_run_tank_pressure| >= |rocket_sim_supply_tank_pressure| * 0.9:
            transition vent
        else:
            command |rocket_sim_vent_request| = 0
            command |rocket_sim_fill_request| = 1

    state vent:
        if |rocket_sim_abort_active| != 0 or |rocket_sim_sensor_valid| != 1 or target_state == states.isolate:
            transition isolate
        elif target_state == states.manual:
            transition manual
        elif |rocket_sim_run_fill| >= |rocket_sim_run_fill_target|:
            |engine_tank_fill_complete| = 1
            transition isolate
        elif |rocket_sim_run_tank_pressure| <= 500:
            transition fill
        else:
            command |rocket_sim_fill_request| = 0
            command |rocket_sim_vent_request| = 1

    state manual:
        once:
            free |rocket_sim_fill_request|
            free |rocket_sim_vent_request|
        if target_state == states.isolate:
            transition isolate
        if target_state == states.fill:
            transition fill

    end:
        if |rocket_sim_abort_active| == 0:
            command |rocket_sim_fill_request| = 0
            command |rocket_sim_vent_request| = 0
        free |rocket_sim_fill_request|
        free |rocket_sim_vent_request|

task_sequence engine_ignition:
    start:
        |engine_ignition_complete| = 0

    wait_until(|rocket_sim_abort_active| == 0 and |rocket_sim_sensor_valid| == 1, 0, 30)
    wait_until(|rocket_sim_abort_active| == 0 and |rocket_sim_sensor_valid| == 1, 0, 30)
    log("Engine test", "Ignition: energizing the simulated igniter")
    command |rocket_sim_igniter_command| = 1
    wait(2)
    wait_until(|rocket_sim_abort_active| == 0 and |rocket_sim_sensor_valid| == 1, 0, 30)
    log("Engine test", "Firing: opening the simulated feed valves")
    |rocket_sim_phase| = 3
    command |rocket_sim_fuel_request| = 1
    command |rocket_sim_oxidizer_request| = 1
    wait(8)
    |engine_ignition_complete| = 1

    end:
        command |rocket_sim_fuel_request| = 0
        command |rocket_sim_oxidizer_request| = 0
        command |rocket_sim_igniter_command| = 0

task_timeline rocket_test 20:
    clock_start: T-2m

    at T-2m (setup):
        hold_at: next_bucket
        execute:
            test_name = promptString(
                "Engine test recording",
                "Name the data frame for this engine test.",
                [],
                "Enter a test name.",
                0
            )
            test_data_frame = startDataFrame(test_name, {"channels": [
                "rocket_sim_run_fill", "rocket_sim_run_fill_target", "rocket_sim_run_tank_pressure",
                "rocket_sim_fill_state", "rocket_sim_vent_state", "rocket_sim_phase",
                "rocket_sim_temperature_voted", "rocket_sim_pressure", "rocket_sim_flow"
            ]})

    at T-1m (tank_fill):
        hold_at: next_bucket
        execute:
            wait_until(|rocket_sim_sensor_valid| == 1 and |rocket_sim_abort_active| == 0, 0, 15)
            |rocket_sim_phase| = 1
            |engine_tank_fill_complete| = 0
            command |engine_tank_fill_running| = 1
            command |engine_tank_fill_target_state| = 1
            wait_until(|engine_tank_fill_complete| == 1, 0)
            command |engine_tank_fill_target_state| = 0
            wait_until(|engine_tank_fill_current_state| == 0, 0)
            free |engine_tank_fill_target_state|
            free |engine_tank_fill_running|

    at T+0s (ignition):
        hold_at: next_bucket
        execute:
            wait_until(|engine_tank_fill_complete| == 1, 0)
            wait_until(|rocket_sim_sensor_valid| == 1 and |rocket_sim_abort_active| == 0, 0, 15)
            |rocket_sim_phase| = 2
            |engine_ignition_complete| = 0
            command |engine_ignition_running| = 1
            wait_until(|engine_ignition_complete| == 1, 0, 60)
            |rocket_sim_phase| = 0
            log("Engine test", "Test fire complete")

    at T+15s (cleanup):
        execute:
            stopDataFrame(test_data_frame)
            test_data_frame = nil
            log("Engine test", "Recording saved")

    abort:
        if test_data_frame:
            stopDataFrame(test_data_frame)
            test_data_frame = nil
        command |engine_tank_fill_target_state| = 0
        command |engine_ignition_running| = 0
        |rocket_sim_phase| = 0

    stop:
        if test_data_frame:
            stopDataFrame(test_data_frame)
            test_data_frame = nil
        command |engine_tank_fill_target_state| = 0
        command |engine_ignition_running| = 0
        |rocket_sim_phase| = 0
